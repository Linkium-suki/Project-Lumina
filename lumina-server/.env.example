# 复制为 .env 后按需修改。所有敏感值均通过环境变量注入，绝不写入代码或提交仓库。

# 数据库
DB_URL=jdbc:postgresql://localhost:5432/lumina
DB_USER=lumina
DB_PASSWORD=lumina

# 加密主密钥：AES-256-GCM 需要至少 32 字节，建议使用 32 字节随机值。
# 生成命令（Linux/macOS）：openssl rand -base64 32
LUMINA_MASTER_KEY=change-me-to-a-32-byte-random-key!!

# 守夜人兜底（作者自持 Key，互助池枯竭时启用）
LUMINA_WATCHMAN_ENABLED=false
LUMINA_WATCHMAN_DEEPSEEK_KEY=
LUMINA_WATCHMAN_QWEN_KEY=

# Azure TTS
AZURE_TTS_REGION=eastasia
AZURE_TTS_KEY=
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 服务端口
SERVER_PORT=8080
